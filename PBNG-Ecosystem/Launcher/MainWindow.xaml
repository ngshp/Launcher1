<Window
    x:Class="Launcher.MainWindow"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    Title="PBNG Launcher"

    Height="450"

    Width="800"

    Background="#111827">

<Grid>

<StackPanel
    VerticalAlignment="Center"
    HorizontalAlignment="Center">

<TextBlock
    Text="PBNG Launcher"

    FontSize="40"

    Foreground="White"

    Margin="20"/>

<Button
    Content="PLAY"

    Width="200"

    Height="50"/>

</StackPanel>

</Grid>
</Window>
