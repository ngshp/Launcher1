<Window x:Class="PBNG.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PBNG Launcher v1.0.104 - SUCCESS" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#070a14">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="PBNG" FontSize="64" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" FontFamily="Consolas"/>
            <TextBlock Text="LAUNCHER" FontSize="64" FontWeight="Bold" Foreground="#00e5ff" HorizontalAlignment="Center" FontFamily="Consolas" Margin="0,-15,0,0"/>
            <TextBlock Text="BUILD #104 SUCCESS • 1m 32s • VERIFIED" Foreground="#22c55e" HorizontalAlignment="Center" Margin="0,20,0,0" FontWeight="Bold"/>
            <TextBlock Text="Discord Rich Presence ON • Auto-Updater ON" Foreground="#94a3b8" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            <Button x:Name="LaunchButton" Content="🚀 LAUNCH GAME" Width="200" Height="45" Margin="0,30,0,0" Background="#00e5ff" Foreground="Black" FontWeight="Bold" FontSize="14"/>
        </StackPanel>
        
        <TextBlock Grid.Row="1" Text="© 2026 PBNG Ecosystem • Built by ngshp • v1.0.104" Foreground="#475569" HorizontalAlignment="Center" Margin="10" FontSize="11"/>
    </Grid>
</Window>
