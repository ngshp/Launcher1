<Window x:Class="PBNG.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PBNG Launcher v1.0.104 - MULTILANG" Height="650" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#070a14">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Top Bar with Language Selector -->
        <Border Grid.Row="0" Background="#0f172a" Padding="15,10">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionText" Text="v1.0.104" Foreground="#475569" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text=" • " Foreground="#475569" Margin="5,0"/>
                    <TextBlock x:Name="VerifiedText" Text="Verified • Build #105" Foreground="#22c55e" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="LangLabel" Text="🌐 Language:" Foreground="#94a3b8" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="LangCombo" Width="140" Height="26" Background="#1e293b" Foreground="White" BorderBrush="#334155"
                              SelectionChanged="LangCombo_SelectionChanged">
                        <ComboBoxItem Content="🇮🇩 ID - Indonesia" Tag="ID"/>
                        <ComboBoxItem Content="🇺🇸 EN - English" Tag="EN"/>
                        <ComboBoxItem Content="🇫🇷 FR - Français" Tag="FR"/>
                        <ComboBoxItem Content="🇷🇺 RU - Русский" Tag="RU"/>
                        <ComboBoxItem Content="🇨🇳 CN - 中文" Tag="CN"/>
                        <ComboBoxItem Content="🇸🇦 AR - العربية" Tag="AR"/>
                        <ComboBoxItem Content="🇮🇷 IR - فارسی" Tag="IR"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="PBNG" FontSize="72" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" FontFamily="Consolas"/>
            <TextBlock x:Name="TitleText" Text="LAUNCHER" FontSize="72" FontWeight="Bold" Foreground="#00e5ff" HorizontalAlignment="Center" FontFamily="Consolas" Margin="0,-20,0,0"/>
            <TextBlock x:Name="SubtitleText" Text="Point Blank NG - Private Server" Foreground="#94a3b8" HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="14"/>
            
            <StackPanel x:Name="StatusPanel" Margin="0,25,0,0" HorizontalAlignment="Center">
                <TextBlock x:Name="SuccessText" Text="SUCCESS • Terverifikasi • Build #105" Foreground="#22c55e" HorizontalAlignment="Center" FontWeight="Bold"/>
                <TextBlock x:Name="DiscordText" Text="Discord Rich Presence ON • Auto-Updater ON" Foreground="#475569" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="12"/>
            </StackPanel>
            
            <Button x:Name="LaunchButton" Content="🚀 LUNCURKAN GAME" Width="260" Height="52" Margin="0,35,0,0" Background="#00e5ff" Foreground="Black" FontWeight="Bold" FontSize="15" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
            
            <TextBlock x:Name="WelcomeText" Text="Selamat Datang di PBNG Ecosystem" Foreground="#334155" HorizontalAlignment="Center" Margin="0,20,0,0" FontSize="11"/>
        </StackPanel>
        
        <TextBlock Grid.Row="2" Text="© 2026 PBNG Ecosystem • Built by ngshp • 7 Languages • v1.0.104" Foreground="#1e293b" HorizontalAlignment="Center" Margin="12" FontSize="11"/>
    </Grid>
</Window>
