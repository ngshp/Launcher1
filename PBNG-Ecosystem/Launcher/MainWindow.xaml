<Window x:Class="PBNG.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PBNG LAUNCHER v3.6.0 PRO" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen" Background="#0A0E14"
        WindowStyle="None" AllowsTransparency="True" Loaded="Window_Loaded">
    <Grid Background="#0A0E14" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Image x:Name="heroImage" Source="hero.png" Stretch="UniformToFill" Opacity="0.9"/>
        <Grid Background="#550A0E14"/>
        <DockPanel VerticalAlignment="Top" Height="65" Background="#0C0C0C">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="20,0">
                <TextBlock Text="PBNG" FontSize="32" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text=" POINT BLANK NEXT GENERATION" FontSize="10" Foreground="#888" VerticalAlignment="Center" Margin="10,0"/>
                <StackPanel Orientation="Horizontal" Margin="15,0" VerticalAlignment="Center">
                    <TextBlock Text="🌐 WEBSITE" Foreground="#666" FontSize="9" Margin="0,0,10,0"/>
                    <TextBlock Text="▶ YOUTUBE" Foreground="#666" FontSize="9" Margin="0,0,10,0"/>
                    <TextBlock Text="💬 DISCORD" Foreground="#00D4FF" FontSize="9" FontWeight="Bold" Margin="0,0,10,0"/>
                    <TextBlock Text="f FACEBOOK" Foreground="#666" FontSize="9"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="20,0" VerticalAlignment="Center">
                <Border Background="#1A1A1A" CornerRadius="20" Padding="12,6" Margin="10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#00FF00" Margin="0,0,6,0"/>
                        <TextBlock x:Name="txtOnline" Text="ONLINE 1024" Foreground="White" FontSize="10" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Background="#1A1A1A" CornerRadius="6" Width="32" Height="32" Margin="5,0"><TextBlock Text="👤" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <Border Background="#1A1A1A" CornerRadius="6" Width="32" Height="32" Margin="5,0"><TextBlock Text="⚙" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <Button Content="✕" Width="32" Height="32" Background="#1A1A1A" Foreground="White" BorderThickness="0" Click="Close_Click"/>
            </StackPanel>
        </DockPanel>
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,85,0,0" Width="340" Background="#0F1115" CornerRadius="10" Padding="12" Opacity="0.95">
            <StackPanel>
                <TextBlock Text="LATEST NEWS" Foreground="White" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>
                <Border Background="#15171C" CornerRadius="6" Margin="0,0,0,8"><StackPanel Margin="10,8"><TextBlock Text="NEW MAP: OUTPOST" Foreground="White" FontWeight="Bold" FontSize="11"/><TextBlock Text="Map baru penuh strategi!" Foreground="#999" FontSize="9"/><TextBlock Text="23 AUG 2026" Foreground="#00D4FF" FontSize="7" Margin="0,3,0,0"/></StackPanel></Border>
                <Border Background="#15171C" CornerRadius="6" Margin="0,0,0,8"><StackPanel Margin="10,8"><TextBlock Text="WEAPON BALANCE UPDATE" Foreground="White" FontWeight="Bold" FontSize="11"/><TextBlock Text="Balance lebih fair!" Foreground="#999" FontSize="9"/><TextBlock Text="22 AUG 2026" Foreground="#FF8C00" FontSize="7" Margin="0,3,0,0"/></StackPanel></Border>
                <Border Background="#15171C" CornerRadius="6" Margin="0,0,0,12"><StackPanel Margin="10,8"><TextBlock Text="WEEKEND PLAYTIME" Foreground="White" FontWeight="Bold" FontSize="11"/><TextBlock Text="Hadiah tiap weekend!" Foreground="#999" FontSize="9"/><TextBlock Text="21 AUG 2026" Foreground="#B24BFF" FontSize="7" Margin="0,3,0,0"/></StackPanel></Border>
                <Border Background="#0A0A0A" CornerRadius="4" Padding="8,5"><StackPanel><TextBlock x:Name="txtStatus" Text="Checking auto update..." Foreground="#888" FontSize="8"/><ProgressBar x:Name="progressBar" Height="2" Margin="0,4,0,0" Background="#222" Foreground="#00D4FF"/></StackPanel></Border>
            </StackPanel>
        </Border>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,35,70" Width="400">
            <TextBlock Text="NEXT GENERATION" FontSize="30" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>
            <TextBlock x:Name="txtServerStatus" Text="SECURE • COMPETE • CONQUER • AUTO UPDATE" FontSize="9" Foreground="#00D4FF" HorizontalAlignment="Right" Margin="0,0,0,20"/>
            <Border CornerRadius="3" BorderBrush="#00D4FF" BorderThickness="1" Background="#001122"><Button x:Name="btnStart" Height="65" Background="Transparent" Foreground="White" BorderThickness="0" Click="StartGame_Click"><StackPanel><TextBlock Text="START GAME" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold"/><TextBlock Text="ENTER THE BATTLEFIELD" HorizontalAlignment="Center" FontSize="9" Foreground="#00D4FF"/></StackPanel></Button></Border>
        </StackPanel>
        <DockPanel VerticalAlignment="Bottom" Height="32" Background="#05070A">
            <StackPanel Orientation="Horizontal" Margin="15,0" VerticalAlignment="Center"><TextBlock Text="PBNG LAUNCHER v3.6.0 PRO" Foreground="White" FontSize="9"/><TextBlock x:Name="txtGameReady" Text=" GAME IS READY TO PLAY" Foreground="#00FF66" FontSize="8" Margin="10,0,0,0"/></StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="15,0" VerticalAlignment="Center"><TextBlock x:Name="txtLiveStatus" Text="LIVE: CONNECTING..." Foreground="#888" FontSize="7" Margin="0,0,15,0"/><TextBlock Text="v3.6.0 PRO" Foreground="#00D4FF" FontSize="8"/></StackPanel>
        </DockPanel>
    </Grid>
</Window>
