<Window x:Class="NGPB.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PBNG Launcher v3.6.0" Height="720" Width="1280"
        WindowStyle="None" AllowsTransparency="False" Background="#080C14"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        <Image Source="background_pbng.png" Stretch="UniformToFill"/>
        
        <!-- Header bar like screenshot -->
        <Border Height="58" VerticalAlignment="Top" Background="#0A0F1ACC">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PBNG" Foreground="White" FontSize="32" FontWeight="Black" FontStyle="Italic" FontFamily="Segoe UI Black"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="POINT BLANK NEXT GENERATION" Foreground="White" FontSize="10" FontWeight="Bold" Opacity="0.9"/>
                        <TextBlock Text="NEXT GENERATION BATTLE EXPERIENCE" Foreground="#8A9BB0" FontSize="8" LetterSpacing="2"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#1A2335" CornerRadius="15" Padding="10,5" Margin="0,0,15,0">
                        <TextBlock Text="● ONLINE 1024 PLAYERS" Foreground="#00E676" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="WEBSITE  YOUTUBE  DISCORD  FACEBOOK" Foreground="#8A9BB0" FontSize="11" VerticalAlignment="Center" Margin="0,0,20,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Left News Panel -->
        <Border Width="340" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="25,80,0,0" Background="#0F1522DD" CornerRadius="14" BorderBrush="#1E2D4A" BorderThickness="1" Padding="16">
            <StackPanel>
                <Grid Margin="0,0,0,15">
                    <TextBlock Text="LATEST NEWS" Foreground="White" FontWeight="Bold" FontSize="13"/>
                    <TextBlock Text="VIEW ALL >" Foreground="#00A8FF" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                
                <Border Background="#1A2335" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="#0A1A2F" CornerRadius="6" Height="60"/>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="EVENT" Foreground="White" Background="#0077FF" FontSize="8" Padding="6,2" HorizontalAlignment="Left"/>
                            <TextBlock Text="NEW MAP: OUTPOST" Foreground="White" FontWeight="Bold" FontSize="12" Margin="0,5,0,0"/>
                            <TextBlock Text="Rasakan pertempuran baru di map Outpost yang penuh strategi!" Foreground="#8A9BB0" FontSize="10" TextWrapping="Wrap"/>
                            <TextBlock Text="23 AUG 2026" Foreground="#00E5FF" FontSize="9" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#1A2335" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="#2A1F0A" CornerRadius="6" Height="60"/>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="UPDATE" Foreground="White" Background="#FF9800" FontSize="8" Padding="6,2" HorizontalAlignment="Left"/>
                            <TextBlock Text="WEAPON BALANCE UPDATE" Foreground="White" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Text="Penyesuaian balance senjata untuk pengalaman bermain yang lebih fair." Foreground="#8A9BB0" FontSize="10" TextWrapping="Wrap"/>
                            <TextBlock Text="22 AUG 2026" Foreground="#FF9800" FontSize="9" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#1A2335" CornerRadius="8" Padding="10" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="#1A0F2A" CornerRadius="6" Height="60"/>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="EVENT" Foreground="White" Background="#9C27B0" FontSize="8" Padding="6,2" HorizontalAlignment="Left"/>
                            <TextBlock Text="WEEKEND PLAYTIME" Foreground="White" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Text="Main di akhir pekan dan dapatkan hadiah menarik setiap harinya!" Foreground="#8A9BB0" FontSize="10" TextWrapping="Wrap"/>
                            <TextBlock Text="21 AUG 2026" Foreground="#CE93D8" FontSize="9" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#0A1E3A" CornerRadius="10" Padding="12" BorderBrush="#00A8FF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="OFFICIAL COMMUNITY" Foreground="#8A9BB0" FontSize="9"/>
                        <TextBlock Text="JOIN OUR COMMUNITY" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,2,0,0"/>
                        <TextBlock Text="Bergabung bersama ribuan pasukan PBNG di seluruh dunia!" Foreground="#8A9BB0" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,10"/>
                        <Border Background="#00A8FF22" BorderBrush="#00A8FF" BorderThickness="1" CornerRadius="6" Padding="10,6" HorizontalAlignment="Left">
                            <TextBlock Text="GABUNG SEKARANG  >" Foreground="#00E5FF" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Right Bottom START GAME like screenshot -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,35,85">
            <TextBlock Text="PBNG" Foreground="White" FontSize="24" FontWeight="Black" FontStyle="Italic" HorizontalAlignment="Right" FontFamily="Segoe UI Black"/>
            <TextBlock Text="NEXT GENERATION" Foreground="White" FontSize="36" FontWeight="Black" HorizontalAlignment="Right" Margin="0,-5,0,0" FontFamily="Segoe UI Black"/>
            <TextBlock Text="SECURE  •  COMPETE  •  CONQUER" Foreground="#8A9BB0" FontSize="11" LetterSpacing="3" HorizontalAlignment="Right" Margin="0,5,0,18"/>
            <Button x:Name="StartGameBtn" Width="380" Height="70" Background="#0A1930" BorderBrush="#00E5FF" BorderThickness="2" Cursor="Hand" Click="LaunchBtn_Click">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                <StackPanel>
                    <TextBlock Text="START GAME  >" Foreground="White" FontSize="26" FontWeight="Black" HorizontalAlignment="Center"/>
                    <TextBlock Text="ENTER THE BATTLEFIELD" Foreground="#8A9BB0" FontSize="9" LetterSpacing="2" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <TextBlock Text="✔ CHECK FILES  |  ⚙ SETTINGS  |  🎧 SUPPORT  |  ⏻ EXIT" Foreground="#8A9BB0" FontSize="10"/>
            </StackPanel>
        </StackPanel>

        <!-- Bottom Status Bar -->
        <Border Height="36" VerticalAlignment="Bottom" Background="#080C14" BorderBrush="#1E2D4A" BorderThickness="0,1,0,0">
            <Grid Margin="15,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PBNG LAUNCHER" Foreground="White" FontWeight="Bold" FontSize="11"/>
                    <TextBlock Text=" VERSION 3.6.0" Foreground="#5A6D85" FontSize="10" Margin="5,0"/>
                    <TextBlock Text="   ✔ GAME IS READY TO PLAY" Foreground="#00E676" FontSize="10" Margin="20,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="SERVER STATUS: NORMAL" Foreground="#00E676" FontSize="9" Margin="0,0,20,0"/>
                    <TextBlock Text="YOUR VERSION: 3.6.0" Foreground="#00A8FF" FontSize="9"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
